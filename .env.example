# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Chave de servico. NUNCA prefixe com NEXT_PUBLIC_ e nunca exponha no client.
# Usada apenas nas Server Actions para gravar o voto com seguranca.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ---------------------------------------------------------------------------
# Campanha
# ---------------------------------------------------------------------------
# Data/hora de encerramento da votacao (ISO 8601). Vazio = sem prazo.
NEXT_PUBLIC_VOTING_DEADLINE=2026-12-20T23:59:59-03:00

# Mostra o placar parcial para o publico (true) ou so apos votar (false).
NEXT_PUBLIC_SHOW_LIVE_RESULTS=true

# Limite de votos por IP por hora (antifraude leve).
VOTES_PER_IP_PER_HOUR=8

# Sal usado para gerar o hash do IP (troque por um valor aleatorio longo).
IP_HASH_SALT=troque-este-valor-por-algo-aleatorio
